# user_memories.content/edited_text/whale_message 암호화 키 (AES-256, base64 32바이트).
# 생성: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# 잃어버리면 이미 저장된 값은 복구 불가 — 안전한 곳에 별도 백업해 둘 것.
MEMORY_ENC_KEY=base64-encoded-32-byte-key
